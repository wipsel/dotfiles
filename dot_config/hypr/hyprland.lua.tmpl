---------------------
---- KEYBINDINGS ----
---------------------

hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brillo -A 5"))
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brillo -U 5"))

hl.bind(mod .. " + P", hl.dsp.exec_cmd([[grim -g "$(slurp)" - | swappy -f -]]))

hl.bind(mod .. " + return",  hl.dsp.exec_cmd(terminal))
hl.bind(mod .. " + D",       hl.dsp.exec_cmd(menu))
hl.bind(mod .. " + SHIFT + Q", hl.dsp.window.close())
hl.bind(mod .. " + M",       hl.dsp.exit())
hl.bind(mod .. " + SHIFT + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mod .. " + F",       hl.dsp.window.fullscreen())

hl.bind("SUPER + L", hl.dsp.window.resize({ x = 100,  y = 0,    relative = true }))
hl.bind("SUPER + H", hl.dsp.window.resize({ x = -100, y = 0,    relative = true }))
hl.bind("SUPER + K", hl.dsp.window.resize({ x = 0,    y = -100, relative = true }))
hl.bind("SUPER + J", hl.dsp.window.resize({ x = 0,    y = 100,  relative = true }))

-- Switch workspaces with mod + [0-9], move the active window with mod + SHIFT + [0-9]
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    hl.bind(mod .. " + " .. key,           hl.dsp.focus({ workspace = i }))
    hl.bind(mod .. " + SHIFT + " .. key,   hl.dsp.window.move({ workspace = i }))
end

hl.bind(mod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mod .. " + R",         hl.dsp.window.resize(), { mouse = true })


-------------------------
---- WORKSPACE RULES ----
-------------------------

for i = 1, 9 do
    hl.workspace_rule({ workspace = tostring(i), layout_opts = { orientation = "left" } })
end

-- A host can list the same workspaces on screens at different locations, and Hyprland
-- merges repeated rules for one workspace (last monitor wins). So bind only to connected
-- screens, and rebind on hotplug; Hyprland then moves bound workspaces onto the new screen.
local workspaceScreens = {
{{- range $mons }}{{ if hasKey . "workspaces" }}
    { output = "{{ .output }}", workspaces = { {{ join ", " .workspaces }} } },
{{- end }}{{ end }}
}

local function bindWorkspaces(monitor)
    for _, screen in ipairs(workspaceScreens) do
        if screen.output == "desc:" .. monitor.description then
            for index, workspace in ipairs(screen.workspaces) do
                hl.workspace_rule({ workspace = tostring(workspace), monitor = screen.output, default = index == 1 })
            end
        end
    end
end

for _, monitor in ipairs(hl.get_monitors()) do
    bindWorkspaces(monitor)
end
hl.on("monitor.added", bindWorkspaces)


-------------
---- HY3 ----
-------------
-- hy3 is loaded by `hyprpm reload` on start, so it is absent on the first parse of
-- this file. Hyprland reloads the config once a plugin loads, and this block applies
-- on that second pass.

if hl.plugin.hy3 then
    local hy3 = hl.plugin.hy3

    hl.config({
        plugin = {
            hy3 = {
                tabs = {
                    height       = 8,
                    padding      = 4,
                    render_text  = false,
                    border_width = 0,
                    -- hy3 renamed tabs:col.* to tabs:colors.*
                    colors = { active = "rgba(7e9cd8ee)" },
                },

                autotile = {
                    enable         = true,
                    trigger_width  = 800,
                    trigger_height = 500,
                },
            },
        },
    })

    -- Move focus, i3 style
    hl.bind(mod .. " + J",         hy3.move_focus("l"))
    hl.bind(mod .. " + K",         hy3.move_focus("d"))
    hl.bind(mod .. " + L",         hy3.move_focus("u"))
    hl.bind(mod .. " + semicolon", hy3.move_focus("right"))

    hl.bind(mod .. " + left",  hy3.move_focus("l"))
    hl.bind(mod .. " + down",  hy3.move_focus("d"))
    hl.bind(mod .. " + up",    hy3.move_focus("u"))
    hl.bind(mod .. " + right", hy3.move_focus("right"))

    -- Move windows, i3 style
    hl.bind(mod .. " + SHIFT + H", hy3.move_window("l"))
    hl.bind(mod .. " + SHIFT + L", hy3.move_window("r"))
    hl.bind(mod .. " + SHIFT + K", hy3.move_window("u"))
    hl.bind(mod .. " + SHIFT + J", hy3.move_window("d"))

    hl.bind(mod .. " + SHIFT + left",  hy3.move_window("l"))
    hl.bind(mod .. " + SHIFT + right", hy3.move_window("r"))
    hl.bind(mod .. " + SHIFT + up",    hy3.move_window("u"))
    hl.bind(mod .. " + SHIFT + down",  hy3.move_window("d"))

    hl.bind(mod .. " + T", hy3.change_group("tab"))
    hl.bind(mod .. " + V", hy3.make_group("v"))
    hl.bind(mod .. " + H", hy3.make_group("h"))
    hl.bind(mod .. " + E", hy3.change_group("toggletab"))
end
