-- Hyprland config. Docs: https://wiki.hypr.land/Configuring/Start/
-- Autocompletion: point your LSP at /usr/share/hypr/stubs.

------------------
---- MONITORS ----
------------------
-- Per-host layouts live in .chezmoidata/monitors.yaml, keyed by hostname.
{{- $mons := index .monitors .chezmoi.hostname }}
{{- if $mons }}
{{- range $mons }}
hl.monitor({ output = "{{ .output }}", mode = "{{ .mode }}", position = "{{ .position }}", scale = {{ .scale }}{{ if hasKey . "transform" }}, transform = {{ .transform }}{{ end }} })
{{- end }}
{{- else }}
-- No monitor profile for host '{{ .chezmoi.hostname }}'. Add one to
-- .chezmoidata/monitors.yaml from `hyprctl monitors`, then `chezmoi apply`.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
{{- end }}


---------------------
---- MY PROGRAMS ----
---------------------

local mod         = "ALT"
local terminal    = "alacritty -e fish"
{{- if eq .chezmoi.hostname "obelix" }}
local fileManager = "dolphin"
{{- else }}
local fileManager = "nautilus"
{{- end }}
local menu        = "wofi --show drun"


-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("hyprpm reload -n")
    hl.exec_cmd("waybar & hyprpaper")
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("dunst")
{{- if eq .chezmoi.hostname "obelix" }}
    -- Laptop-only: NetworkManager tray applet + geo-based night light
    hl.exec_cmd("nm-applet")
    hl.exec_cmd("wlsunset -l=5321917 -L=6.5667")
{{- end }}
end)


